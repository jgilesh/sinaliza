  "tips": [
    {
      "id": "tempo",
      "title": "O tempo vem primeiro",
      "text": "Palavras de tempo (HOJE, AMANHÃ, ONTEM, DEPOIS) costumam abrir a frase. O verbo não muda: quem diz quando é a palavra de tempo."
    },
    {
      "id": "pergunta",
      "title": "Perguntas: palavra no fim e expressão no rosto",
      "text": "O QUE, ONDE, QUANDO, QUEM e POR QUE costumam ir para o fim da frase, com as sobrancelhas franzidas. Em perguntas de sim ou não, as sobrancelhas sobem."
    },
    {
      "id": "negacao",
      "title": "Negação: NÃO e o balanço da cabeça",
      "text": "O NÃO costuma vir depois do verbo ou no fim da frase, sempre com a cabeça balançando para os lados."
    },
    {
      "id": "sem-ligacao",
      "title": "Sem artigos e sem SER/ESTAR",
      "text": "A Libras não usa artigos (o, a, um) e normalmente não usa ser/estar: EU CANSADO = eu estou cansado."
    },
    {
      "id": "posse",
      "title": "Posse depois do nome",
      "text": "O possessivo costuma vir depois da pessoa ou coisa: MÃE MEU = minha mãe."
    },
    {
      "id": "topico",
      "title": "Assunto primeiro",
      "text": "É comum começar pelo assunto da frase e depois comentar: FAMÍLIA MEU, EU GOSTAR MUITO."
    },
    {
      "id": "datilologia",
      "title": "Nomes próprios: datilologia",
      "text": "Nomes de pessoas são soletrados letra por letra (A-N-A) até a pessoa receber um sinal próprio."
    }
  ],
